# Copia este archivo a .env con tus valores reales.
# IMPORTANTE: .env está en .gitignore — NUNCA lo subas al repositorio.
#
# Frontend (Vite). La anon key y la VAPID pública son públicas por diseño
# (van embebidas en el build del front).
VITE_SUPABASE_URL=https://tu-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Backend (solo en el VPS/Portainer — no versionar):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@correo.com
